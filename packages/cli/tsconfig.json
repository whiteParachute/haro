{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "paths": {
      "@haro/provider-codex": [
        "../provider-codex/dist/index.d.ts"
      ],
      "@clack/prompts": [
        "../../node_modules/@clack/prompts/dist/index.d.ts"
      ],
      "commander": [
        "../../node_modules/commander/typings/index.d.ts"
      ],
      "@haro/mcp-tools": [
        "../mcp-tools/dist/index.d.ts"
      ],
      "@haro/agentdock-contract": [
        "../agentdock-contract/dist/index.d.ts"
      ],
      "@haro/skills": [
        "../skills/dist/index.d.ts"
      ],
      "@haro/web-api": [
        "../web-api/dist/index.d.ts"
      ]
    }
  },
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../mcp-tools"
    },
    {
      "path": "../agentdock-contract"
    },
    {
      "path": "../skills"
    },
    {
      "path": "../provider-codex"
    },
    {
      "path": "../web-api"
    }
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
